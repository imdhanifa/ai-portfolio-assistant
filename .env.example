# Base URL of Portfolio.Api (matches the `servers` entry in v1.json).
# Copy this file to .env.local and adjust for your environment.
NEXT_PUBLIC_API_URL=https://portfolio-api.mugavai.co

# The site's real, public production URL - required for correct SEO metadata
# (canonical link, Open Graph/Twitter previews, JSON-LD, sitemap, robots.txt).
# No trailing slash. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
