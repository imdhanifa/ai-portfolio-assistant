# Copy to .env and fill in real values. Used by docker-compose.yml.
# Never commit the real .env file.

# Backend (Portfolio.Api)
XAI_API_KEY=
# Fallback LLM provider, used automatically if Grok fails (no credits, outage, etc.) - optional.
OPENAI_API_KEY=

# Frontend (portfolio-web) - baked in at build time, so it must be set before `docker compose build`
NEXT_PUBLIC_API_URL=http://localhost:8080
# Used for metadataBase, sitemap.xml, robots.txt, canonical/OG tags - set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
