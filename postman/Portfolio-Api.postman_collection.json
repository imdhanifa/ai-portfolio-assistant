{
  "info": {
    "_postman_id": "a5f3e6e0-6f0e-4b7a-9d5b-portfolio-api",
    "name": "AI Portfolio Assistant API",
    "description": "Requests for Portfolio.Api (ASP.NET Core / .NET 10) - the backend for Mohamed Hanifa's AI-powered portfolio. Covers health, the MCP-backed structured data endpoints, and the AI chat endpoint.\n\nSet the `baseUrl` collection variable to match how you're running the API:\n- `dotnet run` locally: http://localhost:5290\n- docker compose: http://localhost:8080\n\nInteractive OpenAPI docs (Development only): {{baseUrl}}/scalar/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5290", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Returns 200 \"Healthy\" if the API is up."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Portfolio Data (MCP)",
      "description": "Plain REST endpoints backed by the same MCP tools the AI assistant calls internally (GetProfile/GetSkills/GetProjects/GetExperience).",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api", "profile"] }
          },
          "response": []
        },
        {
          "name": "Get Skills",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/skills", "host": ["{{baseUrl}}"], "path": ["api", "skills"] }
          },
          "response": []
