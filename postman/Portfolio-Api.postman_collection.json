    },
    {
      "name": "Resume",
      "description": "Dynamically generates an ATS-friendly resume PDF from the current portfolio data on every request (no static file involved).",
      "item": [
        {
          "name": "Download Resume PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/resume/pdf", "host": ["{{baseUrl}}"], "path": ["api", "resume", "pdf"] },
            "description": "Returns application/pdf with a Content-Disposition: attachment filename derived from the portfolio owner's name."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Chat",
      "description": "POST /api/chat is rate-limited (10 req/min per IP by default - see RateLimiting:Chat in appsettings.json). A 429 response has an `error` field instead of `answer`/`sources`.",
      "item": [
        {
          "name": "Ask - .NET technologies",
          "request": {
